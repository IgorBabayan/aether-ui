<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="AetherUI">
            <Action name="AETHERUI_RELOAD_UI">
                <Down>AetherUI.Keybinds.ReloadInterface()</Down>
            </Action>
            <Action name="AETHERUI_JUMP_PRIMARY_HOUSE">
                <Down>AetherUI.Keybinds.JumpToPrimaryHouse()</Down>
            </Action>

            <!--
                One slot per companion, in collectible-id order (new companions get
                higher ids, so existing binds never shift). Names are set from Lua;
                slots with no companion get no name and stay out of the Controls menu.
            -->
            <Action name="AETHERUI_SUMMON_COMPANION_1"><Down>AetherUI.Keybinds.SummonCompanion(1)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_2"><Down>AetherUI.Keybinds.SummonCompanion(2)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_3"><Down>AetherUI.Keybinds.SummonCompanion(3)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_4"><Down>AetherUI.Keybinds.SummonCompanion(4)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_5"><Down>AetherUI.Keybinds.SummonCompanion(5)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_6"><Down>AetherUI.Keybinds.SummonCompanion(6)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_7"><Down>AetherUI.Keybinds.SummonCompanion(7)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_8"><Down>AetherUI.Keybinds.SummonCompanion(8)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_9"><Down>AetherUI.Keybinds.SummonCompanion(9)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_10"><Down>AetherUI.Keybinds.SummonCompanion(10)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_11"><Down>AetherUI.Keybinds.SummonCompanion(11)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_12"><Down>AetherUI.Keybinds.SummonCompanion(12)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_13"><Down>AetherUI.Keybinds.SummonCompanion(13)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_14"><Down>AetherUI.Keybinds.SummonCompanion(14)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_15"><Down>AetherUI.Keybinds.SummonCompanion(15)</Down></Action>
            <Action name="AETHERUI_SUMMON_COMPANION_16"><Down>AetherUI.Keybinds.SummonCompanion(16)</Down></Action>
        </Category>
    </Layer>
</Bindings>
