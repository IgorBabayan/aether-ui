<GuiXml>
    <Animations>
        <!-- Slow breathing glow while a resource is low (Skyrim "running out" flash). -->
        <AnimationTimeline name="AetherUI_LowPulseAnim" playbackType="PING_PONG" loopCount="LOOP_INDEFINITELY">
            <Animations>
                <AlphaAnimation duration="560" startAlpha="0.05" endAlpha="0.45">
                    <EasingFunction>return ZO_EaseInOutQuadratic(progress)</EasingFunction>
                </AlphaAnimation>
            </Animations>
        </AnimationTimeline>

        <!-- Three quick blinks when an ability fails for lack of resource. -->
        <AnimationTimeline name="AetherUI_AlertBlinkAnim" playbackType="PING_PONG" loopCount="6">
            <Animations>
                <AlphaAnimation duration="110" startAlpha="0" endAlpha="1" />
            </Animations>
        </AnimationTimeline>

        <!-- Short white flash over the fill when damage lands. -->
        <AnimationTimeline name="AetherUI_HitFlashAnim">
            <Animations>
                <AlphaAnimation duration="320" startAlpha="0.55" endAlpha="0">
                    <EasingFunction>return ZO_EaseOutQuadratic(progress)</EasingFunction>
                </AlphaAnimation>
            </Animations>
        </AnimationTimeline>
    </Animations>

    <Controls>
        <!--
            One resource bar. All pieces are untextured quads tinted from Lua
            (vertex-colour gradients), so the addon ships no .dds assets.
            Draw order is set with "level".
        -->
        <Control name="AetherUI_ResourceBar" virtual="true">
            <Dimensions x="300" y="11" />
            <Controls>
                <!-- Unlock mode, default layout: per-bar drag highlight + name. -->
                <Texture name="$(parent)DragOverlay" color="C8A464" alpha="0.18" hidden="true" level="0">
                    <Anchor point="TOPLEFT" offsetX="-34" offsetY="-10" />
                    <Anchor point="BOTTOMRIGHT" offsetX="34" offsetY="10" />
                </Texture>
                <Label name="$(parent)DragLabel" font="ZoFontGameSmall" color="E8DCC0" hidden="true" level="16">
                    <Anchor point="TOP" relativePoint="BOTTOM" offsetY="12" />
                </Label>
                <Texture name="$(parent)Glow" alpha="0" hidden="true" level="1">
                    <Anchor point="TOPLEFT" offsetX="-7" offsetY="-6" />
                    <Anchor point="BOTTOMRIGHT" offsetX="7" offsetY="6" />
                </Texture>
                <Texture name="$(parent)Alert" alpha="0" hidden="true" level="2">
                    <Anchor point="TOPLEFT" offsetX="-5" offsetY="-4" />
                    <Anchor point="BOTTOMRIGHT" offsetX="5" offsetY="4" />
                </Texture>

                <!-- Frame: black rim, bronze bevel, dark gap, recessed track. -->
                <Texture name="$(parent)Rim" color="050403" alpha="0.92" level="3">
                    <Anchor point="TOPLEFT" offsetX="-3" offsetY="-3" />
                    <Anchor point="BOTTOMRIGHT" offsetX="3" offsetY="3" />
                </Texture>
                <Texture name="$(parent)Bevel" level="4">
                    <Anchor point="TOPLEFT" offsetX="-2" offsetY="-2" />
                    <Anchor point="BOTTOMRIGHT" offsetX="2" offsetY="2" />
                </Texture>
                <Texture name="$(parent)Gap" color="0A0806" level="5">
                    <Anchor point="TOPLEFT" offsetX="-1" offsetY="-1" />
                    <Anchor point="BOTTOMRIGHT" offsetX="1" offsetY="1" />
                </Texture>
                <Texture name="$(parent)Track" level="6">
                    <AnchorFill />
                </Texture>

                <!-- Value layers (anchored from Lua according to drain direction). -->
                <Texture name="$(parent)Gain" level="7" hidden="true" />
                <Texture name="$(parent)Trail" level="8" hidden="true" />
                <Texture name="$(parent)Fill" level="9" />
                <Texture name="$(parent)Shine" color="FFFFFF" alpha="0.16" level="10">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Fill" relativePoint="TOPLEFT" offsetY="1" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Fill" relativePoint="TOPRIGHT" offsetY="1" />
                    <Dimensions y="4" />
                </Texture>
                <Texture name="$(parent)Shield" level="11" hidden="true">
                    <Anchor point="CENTER" relativeTo="$(parent)Track" relativePoint="CENTER" />
                    <Dimensions x="0" y="11" />
                </Texture>
                <Texture name="$(parent)Flash" color="FFFFFF" alpha="0" level="12">
                    <AnchorFill relativeTo="$(parent)Fill" />
                </Texture>

                <!-- Nordic-style diamond end caps with tapering spikes. -->
                <Texture name="$(parent)SpikeL" level="13">
                    <Anchor point="RIGHT" relativePoint="LEFT" offsetX="-6" />
                    <Dimensions x="22" y="1" />
                </Texture>
                <Texture name="$(parent)SpikeR" level="13">
                    <Anchor point="LEFT" relativePoint="RIGHT" offsetX="6" />
                    <Dimensions x="22" y="1" />
                </Texture>
                <Texture name="$(parent)CapL" level="14">
                    <Anchor point="CENTER" relativePoint="LEFT" offsetX="-3" />
                    <Dimensions x="11" y="11" />
                </Texture>
                <Texture name="$(parent)CapR" level="14">
                    <Anchor point="CENTER" relativePoint="RIGHT" offsetX="3" />
                    <Dimensions x="11" y="11" />
                </Texture>
                <Texture name="$(parent)CapLInner" color="120E0A" level="15">
                    <Anchor point="CENTER" relativeTo="$(parent)CapL" />
                    <Dimensions x="5" y="5" />
                </Texture>
                <Texture name="$(parent)CapRInner" color="120E0A" level="15">
                    <Anchor point="CENTER" relativeTo="$(parent)CapR" />
                    <Dimensions x="5" y="5" />
                </Texture>

                <!-- Value text, drawn inside the bar (bar grows taller when text is on). -->
                <Label name="$(parent)Value" font="$(BOLD_FONT)|13|soft-shadow-thick" color="F4ECD8"
                       horizontalAlignment="CENTER" verticalAlignment="CENTER" hidden="true" level="16">
                    <Anchor point="CENTER" relativeTo="$(parent)Track" relativePoint="CENTER" offsetY="1" />
                </Label>
            </Controls>
        </Control>

        <!-- One buff / debuff icon (Buffs module). Frame colors are set in Lua. -->
        <Control name="AetherUI_BuffIcon" virtual="true" hidden="true">
            <Dimensions x="32" y="32" />
            <Controls>
                <Texture name="$(parent)Rim" color="050403" alpha="0.92" level="1">
                    <Anchor point="TOPLEFT" offsetX="-2" offsetY="-2" />
                    <Anchor point="BOTTOMRIGHT" offsetX="2" offsetY="2" />
                </Texture>
                <Texture name="$(parent)Bevel" level="2">
                    <Anchor point="TOPLEFT" offsetX="-1" offsetY="-1" />
                    <Anchor point="BOTTOMRIGHT" offsetX="1" offsetY="1" />
                </Texture>
                <Texture name="$(parent)Icon" level="3">
                    <AnchorFill />
                    <TextureCoords left="0.06" right="0.94" top="0.06" bottom="0.94" />
                </Texture>
                <!-- Countdown under the icon (temporary buffs only). -->
                <Label name="$(parent)Time" font="$(BOLD_FONT)|12|soft-shadow-thick" color="F4ECD8"
                       horizontalAlignment="CENTER" level="4">
                    <Anchor point="TOP" relativePoint="BOTTOM" offsetY="2" />
                </Label>
                <Label name="$(parent)Stack" font="$(BOLD_FONT)|12|soft-shadow-thick" color="E8C878"
                       horizontalAlignment="RIGHT" level="4">
                    <Anchor point="TOPRIGHT" offsetX="-1" offsetY="-1" />
                </Label>
            </Controls>
        </Control>

        <!--
            Target bar (Target module). The fragment owns the top-level's hidden
            state; the inner Frame is shown only while there is a target (or a
            placeholder in unlock / settings preview). The bar and the effect
            icons are created in Lua inside the Frame.
        -->
        <TopLevelControl name="AetherUI_Target" hidden="true" mouseEnabled="false">
            <Dimensions x="300" y="20" />
            <Controls>
                <Control name="$(parent)Frame" hidden="true">
                    <AnchorFill />
                    <Controls>
                        <Label name="$(parent)Name" font="$(BOLD_FONT)|15|soft-shadow-thick" color="E8DCC0"
                               maxLineCount="1" wrapMode="TEXT_WRAP_MODE_ELLIPSIS" verticalAlignment="BOTTOM" />
                        <Label name="$(parent)Level" font="$(BOLD_FONT)|13|soft-shadow-thick" color="C8A464"
                               horizontalAlignment="RIGHT" verticalAlignment="BOTTOM" />
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>

        <!--
            Mini-boss bars (MiniBoss module). The top-level is the size of one
            bar; the bars are created in Lua inside the Frame, stacked down from
            its top. The Frame is shown only while there is a mini-boss (or a
            placeholder in unlock / settings preview).
        -->
        <TopLevelControl name="AetherUI_MiniBoss" hidden="true" mouseEnabled="false">
            <Dimensions x="300" y="20" />
            <Controls>
                <Control name="$(parent)Frame" hidden="true">
                    <AnchorFill />
                </Control>
            </Controls>
        </TopLevelControl>

        <!--
            Companion bar (Companion module). Same pattern as the target bar:
            the fragment owns the top-level, the inner Frame is shown only while
            a companion is out (or a placeholder in unlock / settings preview).
        -->
        <TopLevelControl name="AetherUI_Companion" hidden="true" mouseEnabled="false">
            <Dimensions x="300" y="20" />
            <Controls>
                <Control name="$(parent)Frame" hidden="true">
                    <AnchorFill />
                </Control>
            </Controls>
        </TopLevelControl>

        <!--
            Group / raid frames (Group module). The fragment owns the
            top-level; the inner Frame is shown only while grouped (or as a
            placeholder in unlock / settings preview). The top-level is resized
            to the shown grid; in unlock mode it takes the mouse and is dragged
            as one piece. Member bars are created in Lua inside the Frame.
        -->
        <TopLevelControl name="AetherUI_Group" hidden="true" mouseEnabled="false">
            <Dimensions x="240" y="24" />
            <Controls>
                <Control name="$(parent)Frame" hidden="true">
                    <AnchorFill />
                </Control>
                <Texture name="$(parent)DragOverlay" color="C8A464" alpha="0.18" hidden="true" level="0">
                    <Anchor point="TOPLEFT" offsetX="-24" offsetY="-10" />
                    <Anchor point="BOTTOMRIGHT" offsetX="24" offsetY="10" />
                </Texture>
                <Label name="$(parent)DragLabel" font="ZoFontGameSmall" color="E8DCC0" hidden="true"
                       text="Group frames">
                    <Anchor point="BOTTOM" relativePoint="TOP" offsetY="-12" />
                </Label>
            </Controls>
        </TopLevelControl>

        <!-- Dragging and screen clamping are handled in Lua (ResourceBars). -->
        <TopLevelControl name="AetherUI_Bars" hidden="true" mouseEnabled="false">
            <Dimensions x="1080" y="44" />
            <Controls>
                <Texture name="$(parent)DragOverlay" color="C8A464" alpha="0.18" hidden="true">
                    <AnchorFill />
                </Texture>
                <Label name="$(parent)DragLabel" font="ZoFontGameSmall" color="E8DCC0" hidden="true"
                       text="AetherUI: drag to move, then /aether lock">
                    <Anchor point="BOTTOM" relativePoint="TOP" offsetY="-6" />
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
